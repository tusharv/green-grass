# Local defaults. On Render these are set by render.yaml.
DATABASE_URL=sqlite:///./data/greengrass.db
SESSION_SECRET=replace-with-a-long-random-string
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_HOST=https://ollama.com
# Set to 1 behind HTTPS (Render). Leave unset for local http.
COOKIE_SECURE=0
# Comma-separated emails promoted to admin on register/login (ops console at /admin).
ADMIN_EMAILS=
